DATABASE_URL=postgresql://YOUR_BACKEND_ROLE:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
# Store a random secret (at least 32 characters) in .jwt_secret, or set JWT_SECRET.
ALLOWED_ORIGINS=http://localhost:3000
# Steam Web API key from https://steamcommunity.com/dev/apikey (backend only).
STEAM_API_KEY=YOUR_STEAM_API_KEY
PORT=8080
